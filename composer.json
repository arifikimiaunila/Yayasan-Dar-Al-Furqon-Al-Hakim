{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",

    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "laravel/boost": "^2.0",
        "laravel/tinker": "^3.0",

        "laravel/jetstream": "*",
        "laravel/octane": "^2.17",
        "laravel/scout": "*",
        "laravel/telescope": "*",

        "mostafaznv/laracache": "*",
        "santigarcor/laratrust": "*"
    },

    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^9.0",
        "phpunit/phpunit": "^12.0"
    },

    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },

    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    }
}
